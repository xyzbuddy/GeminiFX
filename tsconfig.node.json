{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "chrome", "vite/client"]
  },
  "include": ["vite.config.ts", "vite.content.config.ts", "vitest.config.ts", "tests"]
}
